# Environment Configuration Template
# Duplicate this file to .env for local development

PORT=5000
NODE_ENV=development

# Database Connection (Render PostgreSQL or local)
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/earnloop_db?schema=public"

# Authentication & Security
JWT_SECRET="your-super-secret-jwt-token-key-change-in-production"
SESSION_SECRET="your-session-cookie-secret"
ADMIN_PIN="EarnLoop@Admin#2026"

# SMS OTP Provider Config
# Options: "mock" (logs OTP to console/response for dev) or "twilio" / "fast2sms"
SMS_PROVIDER="mock"
SMS_MOCK_MODE="true"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Payment & Exchange Defaults
INR_TO_MCOIN_RATE="1.0"
USDT_TO_MCOIN_RATE="110.5"
ADMIN_UPI_ID="paytm.earnloop@okaxis"
ADMIN_USDT_TRC20="TQn9Y2khEsLJW1ChVWFMSMeSTow5KaxUSDT"

# App & Support Links
SUPPORT_TELEGRAM="https://t.me/earnloop_official"
SUPPORT_WHATSAPP="https://wa.me/918619142008"
SUPPORT_EMAIL="support@earnloopfin.com"
FRONTEND_URL="http://localhost:5173"
